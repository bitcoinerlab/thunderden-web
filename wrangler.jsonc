{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thunderden-web",
  "main": "deploy/cloudflare-worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [
    { "pattern": "thunderden.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/assets/thunderden.img",
      "/assets/site/thunderden.img",
      "/emulator/qemu-system-x86_64.wasm"
    ]
  },
  "send_metrics": false
}
